# Environment variables for MMAS Django Project
# Copy this file to .env and update the values

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False

# Database (for future use if switching to PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/mmas_db

# Email Settings (for future use)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
